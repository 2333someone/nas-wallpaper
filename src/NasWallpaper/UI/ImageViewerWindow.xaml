<Window x:Class="NasWallpaper.UI.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="查看壁纸" Icon="/Assets/app.ico" Width="1180" Height="760" MinWidth="720" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ViewerButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource Btn}"
                                BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerPrimaryButton" TargetType="Button" BasedOn="{StaticResource ViewerButton}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource AccentGradient}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerIconButton" TargetType="Button" BasedOn="{StaticResource ViewerButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid Margin="18,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" Foreground="{DynamicResource OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </Border>
                    <TextBlock x:Name="TitleText" Margin="11,0,0,0" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    <Border Background="{DynamicResource ChipBg}" CornerRadius="7" Padding="8,3" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CounterText" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="NoWrap" />
                    </Border>
                    <Border Background="{DynamicResource ChipBg}" CornerRadius="7" Padding="8,3" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="MonitorNameText" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="NoWrap" />
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource ViewerIconButton}" Content="&#xE8BB;" Click="Close_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="关闭 (Esc)" />
            </Grid>
        </Border>

        <!-- 大图 -->
        <Grid Grid.Row="1" Background="#08090C">
            <Image x:Name="ViewerImage" Stretch="Uniform" Margin="16"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" Text="正在载入…" />
            </StackPanel>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviousButton" Style="{StaticResource ViewerButton}" Click="Previous_Click"
                            ToolTip="上一张 (←)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <TextBlock Text="上一张" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource ViewerButton}" Click="Next_Click"
                            Margin="8,0,0,0" ToolTip="下一张 (→)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="下一张" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="PreviewSizeText" Grid.Column="1" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiary}" Margin="16,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DeleteButton" Style="{StaticResource ViewerButton}" Content="删除这张"
                            Foreground="{DynamicResource TextSecondary}" Click="Delete_Click"
                            ToolTip="从 NAS 上删除这张原图（需要再点一次确认）" />
                    <Button x:Name="ApplyButton" Style="{StaticResource ViewerPrimaryButton}" Click="Apply_Click"
                            Margin="8,0,0,0" ToolTip="立即设为这台显示器的壁纸 (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <TextBlock Text="设为壁纸" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
