<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==== 基础表面 ==== -->
    <SolidColorBrush x:Key="Bg" Color="#0B0C11" />
    <SolidColorBrush x:Key="Surface" Color="#12141B" />
    <SolidColorBrush x:Key="SurfaceHi" Color="#171A23" />
    <SolidColorBrush x:Key="SurfaceInset" Color="#0F131B" />
    <SolidColorBrush x:Key="TileBg" Color="#111520" />
    <SolidColorBrush x:Key="Field" Color="#0E1016" />
    <SolidColorBrush x:Key="FieldHover" Color="#101320" />
    <SolidColorBrush x:Key="FieldFocus" Color="#232936" />

    <!-- ==== 交互态 ==== -->
    <SolidColorBrush x:Key="NavHover" Color="#171B24" />
    <SolidColorBrush x:Key="RowHover" Color="#12161F" />
    <SolidColorBrush x:Key="Btn" Color="#151922" />
    <SolidColorBrush x:Key="BtnHover" Color="#1C2130" />
    <SolidColorBrush x:Key="BtnPressed" Color="#232A3B" />
    <SolidColorBrush x:Key="IconBtnHover" Color="#1A1F2A" />
    <SolidColorBrush x:Key="ChipBg" Color="#1A1D28" />
    <SolidColorBrush x:Key="BadgeBg" Color="#151A24" />
    <SolidColorBrush x:Key="FooterBg" Color="#101319" />
    <SolidColorBrush x:Key="ToastBg" Color="#181D2A" />
    <SolidColorBrush x:Key="ToastStroke" Color="#2F3650" />
    <SolidColorBrush x:Key="TooltipBg" Color="#171B24" />
    <SolidColorBrush x:Key="TooltipStroke" Color="#2E3545" />

    <!-- ==== 线条与文本 ==== -->
    <SolidColorBrush x:Key="Stroke" Color="#232834" />
    <SolidColorBrush x:Key="StrokeHi" Color="#3A4257" />
    <SolidColorBrush x:Key="TextPrimary" Color="#EEF0F6" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9BA3B7" />
    <SolidColorBrush x:Key="TextTertiary" Color="#6C7488" />

    <!-- ==== 控件细节 ==== -->
    <SolidColorBrush x:Key="TrackOff" Color="#242A38" />
    <SolidColorBrush x:Key="KnobOff" Color="#8A93A6" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#2A3040" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#3B4459" />
    <SolidColorBrush x:Key="ScrollThumbDrag" Color="#4E5872" />
    <SolidColorBrush x:Key="ShadeBrush" Color="#000000" />

    <!-- ==== 品牌色 ==== -->
    <SolidColorBrush x:Key="Accent" Color="#8B7CFF" />
    <SolidColorBrush x:Key="AccentText" Color="#EDEAFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#8B7CFF" Opacity="0.14" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Success" Color="#43D9A3" />
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
    <SolidColorBrush x:Key="DangerText" Color="#FF8A8A" />
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1B22" />

    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="GlowColor">#7B68FF</Color>
    <Color x:Key="HeroShadowColor">#08060F</Color>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A392FF" Offset="0" />
        <GradientStop Color="#6C5BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2257" Offset="0" />
        <GradientStop Color="#161A2B" Offset="0.55" />
        <GradientStop Color="#10161F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A3E8F" Offset="0" />
        <GradientStop Color="#1E2436" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowPrimary">
        <GradientStop Color="#3A2C6E" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="GlowSecondary">
        <GradientStop Color="#1B3A52" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="HeroRing">
        <GradientStop Color="#66A392FF" Offset="0" />
        <GradientStop Color="#008B7CFF" Offset="1" />
    </RadialGradientBrush>

    <!-- ==== 主视觉区文字 ==== -->
    <SolidColorBrush x:Key="HeroTitle" Color="#F6F4FF" />
    <SolidColorBrush x:Key="HeroBody" Color="#E9E5FF" />
    <SolidColorBrush x:Key="HeroMuted" Color="#EDE9FF" />
    <SolidColorBrush x:Key="HeroGhostBg" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="HeroGhostBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="HeroGhostHoverBg" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="HeroGhostPressedBg" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="HeroRingStroke" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="HeroRingStrokeSoft" Color="#1FFFFFFF" />
</ResourceDictionary>
