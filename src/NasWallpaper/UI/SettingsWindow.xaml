<Window x:Class="NasWallpaper.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NasWallpaper.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NAS Wallpaper" Icon="/Assets/app.ico" Width="1200" Height="800" MinWidth="1010" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewDragOver="Window_PreviewDragOver" Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <local:SettingsViewModel />
    </Window.DataContext>

    <Window.Resources>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- ==== 排版 ==== -->
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ==== 卡片 ==== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style x:Key="LiftCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource StrokeHi}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-2" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- ==== 侧边导航 ==== -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Bg" CornerRadius="12" Background="Transparent" />
                            <Border x:Name="Indicator" Width="3" Height="18" HorizontalAlignment="Left" Margin="3,0,0,0"
                                    CornerRadius="2" Background="{DynamicResource AccentGradient}" Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleY="0.3" /></Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="18,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Opacity="0.85" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" TextWrapping="NoWrap" />
                                <ContentPresenter Margin="13,0,0,0" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 按钮 ==== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                            <Border x:Name="Bg" CornerRadius="11" Background="{DynamicResource AccentGradient}" />
                            <Border x:Name="Shade" CornerRadius="11" Background="{DynamicResource ShadeBrush}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            <Border Background="Transparent" CornerRadius="11" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.018" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.018" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.985" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.985" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.018" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.018" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="11" Background="{DynamicResource Btn}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnHover}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource StrokeHi}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="11" Background="{DynamicResource HeroGhostBg}" BorderBrush="{DynamicResource HeroGhostBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HeroGhostHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HeroGhostPressedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,4">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                                <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                           FontSize="9" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" TextWrapping="NoWrap">
                                    <TextBlock.RenderTransform><TranslateTransform X="0" /></TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="3" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Padding="8,3" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource IconBtnHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 输入框 ==== -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Field}"
                                BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"
                                              Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="13,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                           Foreground="{DynamicResource TextTertiary}" FontSize="13" TextWrapping="NoWrap" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeHi}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 密码框 ==== -->
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="PasswordChar" Value="●" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Field}"
                                BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center" Focusable="False" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="13,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiary}" FontSize="13" TextWrapping="NoWrap" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeHi}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldHover}" />
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 下拉框 ==== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="11,9" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="Tick" Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" Visibility="Collapsed" TextWrapping="NoWrap" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldFocus}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Field}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                <Grid>
                    <ContentPresenter Margin="13,0,38,0" VerticalAlignment="Center"
                                      Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                      ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                      ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                      TextBlock.Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,14,0" TextWrapping="NoWrap"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeHi}" />
                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Accent}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Chevron"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="180" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Chevron"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          Template="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True"
                                   PopupAnimation="Fade" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border CornerRadius="12" Background="{DynamicResource TooltipBg}" BorderBrush="{DynamicResource TooltipStroke}" BorderThickness="1"
                                        Padding="5" Margin="0,0,0,10"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 开关 ==== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="44" Height="26" CornerRadius="13" BorderThickness="1"
                                    BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource TrackOff}" VerticalAlignment="Center">
                                <Grid>
                                    <Border x:Name="Fill" CornerRadius="13" Background="{DynamicResource AccentGradient}" Opacity="0" />
                                    <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource KnobOff}"
                                            HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Border.RenderTransform><TranslateTransform X="0" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource StrokeHi}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource OnAccent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== 滚动条 ==== -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="3" Background="{DynamicResource ScrollThumb}" Margin="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbDrag}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ==== 根容器 ==== -->
    <Grid Background="{DynamicResource Bg}">
        <!-- 背景光晕 -->
        <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-420,-280,0" IsHitTestVisible="False" Fill="{DynamicResource GlowPrimary}" />
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-320" IsHitTestVisible="False" Fill="{DynamicResource GlowSecondary}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==== 标题栏 ==== -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </Border>
                    <TextBlock Text="NAS Wallpaper" Margin="11,0,0,0" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" />
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭到托盘" />
                </StackPanel>
            </Grid>

            <!-- ==== 主区域 ==== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="246" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,1,0">
                    <Grid Margin="14,18,14,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="工作台" Style="{StaticResource SectionLabel}" Margin="14,0,0,8" />

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Content="概览" Tag="&#xE80F;"
                                         CommandParameter="0" IsChecked="True" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavGallery" Style="{StaticResource NavItem}" Content="壁纸库" Tag="&#xE8B9;"
                                         CommandParameter="1" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavMonitors" Style="{StaticResource NavItem}" Content="显示器与图片源" Tag="&#xE7F4;"
                                         CommandParameter="2" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Content="缓存与系统" Tag="&#xE713;"
                                         CommandParameter="3" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="关于" Tag="&#xE946;"
                                         CommandParameter="4" Checked="Nav_Checked" />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
                                    BorderThickness="1" Padding="14,13" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SideHint}" Style="{StaticResource Hint}" Margin="0,8,0,12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <Button Content="{Binding PauseText}" Click="Pause_Click" Height="32"
                                            FontSize="12" Style="{StaticResource GhostButton}" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Height="34" Click="Exit_Click" HorizontalContentAlignment="Left"
                                    Padding="14,0" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    <TextBlock Text="退出应用" Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="36,24,36,0">
                        <TextBlock x:Name="PageTitle" Text="概览" FontSize="25" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="PageSubtitle" Text="所有显示器都在后台安静地工作。"
                                   Style="{StaticResource Hint}" FontSize="12.5" Margin="0,6,0,0" />
                    </StackPanel>

                    <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="36,20,26,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="PageHost" Margin="0,0,10,4">

                            <!-- ============ 概览 ============ -->
                            <StackPanel x:Name="OverviewPage" Opacity="0">
                                <Border x:Name="HeroCard" CornerRadius="16" Padding="24,22" Margin="0,0,0,16"
                                        Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource HeroBorder}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.BorderThickness>1</Border.BorderThickness>
                                    <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                       Foreground="{DynamicResource HeroMuted}" TextWrapping="NoWrap" />
                                            <TextBlock Text="让桌面，成为你的画廊。" FontSize="26" FontWeight="Bold"
                                                       Foreground="{DynamicResource HeroTitle}" Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding StatusDetail}" FontSize="12.5" Foreground="{DynamicResource HeroBody}"
                                                       Margin="0,8,0,20" MaxWidth="520" HorizontalAlignment="Left" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource HeroGhostButton}" Click="Previous_Click"
                                                        ToolTip="回到上一张">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                        <TextBlock Text="上一张" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource PrimaryButton}" Click="Next_Click" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                        <TextBlock Text="下一张" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource HeroGhostButton}" Click="Pause_Click" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PauseGlyph}" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                        <TextBlock Text="{Binding PauseText}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="156" Height="156" VerticalAlignment="Center"
                                              IsHitTestVisible="False" Margin="24,0,6,0">
                                            <Ellipse Width="156" Height="156" Stroke="{DynamicResource HeroRingStroke}" StrokeThickness="1" />
                                            <Ellipse Width="112" Height="112" Stroke="{DynamicResource HeroRingStrokeSoft}" StrokeThickness="1" />
                                            <Ellipse Width="76" Height="76" Fill="{DynamicResource HeroRing}" />
                                            <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                       Foreground="{DynamicResource HeroBody}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <UniformGrid Columns="4" Margin="0,0,0,4">
                                    <Border Style="{StaticResource StatCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                <TextBlock Text="显示器" Style="{StaticResource SectionLabel}" Margin="7,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding MonitorCount}" FontSize="22" FontWeight="Bold" Margin="0,8,0,2" />
                                            <TextBlock Text="已连接设备" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Foreground="{DynamicResource Success}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                <TextBlock Text="运行中" Style="{StaticResource SectionLabel}" Margin="7,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding EnabledCount}" FontSize="22" FontWeight="Bold" Margin="0,8,0,2" />
                                            <TextBlock Text="正在轮播" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                <TextBlock Text="缓存" Style="{StaticResource SectionLabel}" Margin="7,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CacheSummary}" FontSize="22" FontWeight="Bold" Margin="0,8,0,2" />
                                            <TextBlock Text="本地占用上限" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatCard}" Margin="0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                <TextBlock Text="样式" Style="{StaticResource SectionLabel}" Margin="7,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StyleName}" FontSize="22" FontWeight="Bold" Margin="0,8,0,2" />
                                            <TextBlock Text="桌面填充方式" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24,20">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="显示器状态" Style="{StaticResource CardTitle}" />
                                            <Button Content="立即刷新" Style="{StaticResource GhostButton}" Height="30"
                                                    FontSize="11.5" Padding="12,0" HorizontalAlignment="Right"
                                                    Click="Refresh_Click" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Monitors}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1"
                                                            Margin="-10,0" Padding="10,14">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource RowHover}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="10" Height="10" VerticalAlignment="Center" Margin="2,0,14,0">
                                                                <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}" Opacity="0.22" />
                                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Status}" FontSize="11.5" Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource TextSecondary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding CurrentImageName}" FontSize="11.5"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           HorizontalAlignment="Right" MaxWidth="240"
                                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                <TextBlock Text="{Binding NextChangeText}" FontSize="11" Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                                                <Button Content="{Binding DeleteText}" Click="DeleteImage_Click" ToolTip="删除 NAS 上的这张原图"
                                                                        HorizontalAlignment="Right" Margin="0,4,-8,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding CanDeleteImage}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DeletePending}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ 壁纸库 ============ -->
                            <StackPanel x:Name="GalleryPage" Opacity="0" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="22,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="图片画廊" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="浏览这台显示器图片源里的全部图片。点击任意一张可以放大查看，并立即设为壁纸。" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox Width="230" ItemsSource="{Binding Monitors}"
                                                      SelectedItem="{Binding Gallery.SelectedMonitor, Mode=TwoWay}"
                                                      SelectionChanged="GalleryMonitor_SelectionChanged" Margin="0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="刷新列表" Style="{StaticResource GhostButton}" Height="34"
                                                    Padding="14,0" Margin="10,0,0,0" Click="GalleryRefresh_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ChipBg}"
                                                BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="把图片拖进窗口，即可上传到 NAS 并立即设为壁纸"
                                                       FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                       Text="图片会复制到所选显示器的图片源目录（同名自动加序号，不覆盖原图）。支持 JPG / PNG / BMP / GIF / TIFF，单张不超过 100 MB。" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="{Binding Gallery.Summary}" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="正在读取…" Style="{StaticResource Hint}" Margin="0,0,12,0"
                                                   Visibility="{Binding Gallery.IsLoading, Converter={StaticResource BoolToVisible}}" />
                                        <Button Content="加载更多" Style="{StaticResource TextButton}" Click="GalleryMore_Click"
                                                Visibility="{Binding Gallery.CanLoadMore, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Gallery.Images}" Margin="0,14,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MouseLeftButtonUp="GalleryImage_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Width" Value="198" />
                                                        <Setter Property="Height" Value="152" />
                                                        <Setter Property="Margin" Value="0,0,14,14" />
                                                        <Setter Property="CornerRadius" Value="12" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
                                                        <Setter Property="Background" Value="{DynamicResource TileBg}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="110" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border CornerRadius="11,11,0,0" ClipToBounds="True"
                                                            Background="{DynamicResource SurfaceInset}">
                                                        <Grid>
                                                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="20" Foreground="{DynamicResource TextTertiary}"
                                                                       Opacity="0.45" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                            <Border CornerRadius="11,11,0,0">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding Thumbnail}"
                                                                                Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" MaxWidth="178"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        <TextBlock Text="{Binding DetailText}" FontSize="10.5" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextTertiary}"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ============ 显示器与图片源 ============ -->
                            <StackPanel x:Name="MonitorsPage" Opacity="0" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="壁纸样式" Style="{StaticResource CardTitle}" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="对所有显示器生效，与 Windows 桌面背景设置一致。" />
                                        </StackPanel>
                                        <ComboBox SelectedIndex="{Binding StyleIndex}" Width="220" Margin="0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ComboBoxItem Content="填充" />
                                            <ComboBoxItem Content="适应" />
                                            <ComboBoxItem Content="拉伸" />
                                            <ComboBoxItem Content="平铺" />
                                            <ComboBoxItem Content="居中" />
                                            <ComboBoxItem Content="跨屏" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Monitors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LiftCard}" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
                                                <StackPanel>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource ChipBg}"
                                                                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                            </Border>
                                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}"
                                                                             VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Status}" Margin="7,0,0,0" FontSize="11"
                                                                               Foreground="{DynamicResource TextSecondary}" MaxWidth="380"
                                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="启用轮播" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="NoWrap" />
                                                            <CheckBox IsChecked="{Binding Enabled}" Content="" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,18" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="图片源" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                                                            <TextBlock Text="来源类型" Style="{StaticResource FieldLabel}" />
                                                            <ComboBox SelectedIndex="{Binding Source.KindIndex}" Margin="0,7,0,14">
                                                                <ComboBoxItem Content="SMB / CIFS 网络路径" />
                                                                <ComboBoxItem Content="WebDAV" />
                                                                <ComboBoxItem Content="本地文件夹" />
                                                            </ComboBox>
                                                            <TextBlock Text="路径或网址" Style="{StaticResource FieldLabel}" />
                                                            <StackPanel Margin="0,7,0,14">
                                                                <TextBox x:Name="PathBox" Text="{Binding Source.Address, UpdateSourceTrigger=PropertyChanged}"
                                                                         PreviewMouseLeftButtonDown="Path_PreviewMouseLeftButtonDown">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                            <Setter Property="Tag" Value="\\192.168.1.100\Photos" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Source.KindIndex}" Value="2">
                                                                                    <Setter Property="Tag" Value="C:\Users\Public\Pictures" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <StackPanel Margin="0,5,0,0">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Source.KindIndex}" Value="2">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button Content="从文件夹中选择…" Style="{StaticResource LinkButton}"
                                                                            Tag="{Binding ElementName=PathBox}" Click="BrowseFolder_Click" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="账号" Style="{StaticResource FieldLabel}" />
                                                                    <TextBox Text="{Binding Source.Username}" Tag="可留空"
                                                                             Margin="0,7,0,14" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                                                                    <PasswordBox PasswordChanged="Password_Changed" Tag="仅本机可解密"
                                                                                 Margin="0,7,0,14" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <CheckBox Content="包含子文件夹" IsChecked="{Binding Source.Recursive}" Margin="0,2,0,0" />
                                                            <StackPanel Margin="0,4,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Source.KindIndex}" Value="1">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <CheckBox Content="信任自签名 HTTPS 证书" IsChecked="{Binding Source.AllowInvalidCertificate}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="轮播节奏" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                                                            <TextBlock Text="切换频率" Style="{StaticResource FieldLabel}" />
                                                            <ComboBox SelectedValue="{Binding IntervalMinutes}" SelectedValuePath="Tag"
                                                                      Margin="0,7,0,14">
                                                                <ComboBoxItem Content="1 分钟" Tag="1" />
                                                                <ComboBoxItem Content="10 分钟" Tag="10" />
                                                                <ComboBoxItem Content="30 分钟" Tag="30" />
                                                                <ComboBoxItem Content="1 小时" Tag="60" />
                                                                <ComboBoxItem Content="6 小时" Tag="360" />
                                                            </ComboBox>
                                                            <TextBlock Text="播放顺序" Style="{StaticResource FieldLabel}" />
                                                            <ComboBox SelectedIndex="{Binding PlaybackIndex}" Margin="0,7,0,14">
                                                                <ComboBoxItem Content="顺序播放" />
                                                                <ComboBoxItem Content="随机播放" />
                                                            </ComboBox>
                                                            <TextBlock Text="壁纸方向" Style="{StaticResource FieldLabel}" />
                                                            <Border CornerRadius="10" Background="{DynamicResource TileBg}" Padding="13,10"
                                                                    Margin="0,7,0,14">
                                                                <StackPanel>
                                                                    <CheckBox Content="允许竖向壁纸" IsChecked="{Binding IncludePortrait}" />
                                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                                               Text="关闭时只轮播横向图片。" />
                                                                </StackPanel>
                                                            </Border>

                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>

                            <!-- ============ 缓存与系统 ============ -->
                            <StackPanel x:Name="SystemPage" Opacity="0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource ChipBg}"
                                                        BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                </Border>
                                                <TextBlock Text="缓存与刷新" Style="{StaticResource CardTitle}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,20"
                                                       Text="缓存目录只保留最近使用的图片，超出上限时按时间清理。" />
                                            <TextBlock Text="缓存上限（MB）" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CacheLimitMb}" Tag="1024" Margin="0,7,0,16" />
                                            <TextBlock Text="缓存保留天数" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding CacheRetentionDays}" Tag="14" Margin="0,7,0,16" />
                                            <TextBlock Text="目录刷新周期（分钟）" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ScanIntervalMinutes}" Tag="60" Margin="0,7,0,0" />
                                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,18" />

                                            <TextBlock Text="缓存位置" Style="{StaticResource FieldLabel}" />
                                            <Border Height="42" CornerRadius="12" Background="{DynamicResource SurfaceInset}" Margin="0,7,0,0"
                                                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="12,0"
                                                    ToolTip="{Binding CachePathText}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding CachePathText}" Margin="10,0,0,0" FontSize="12"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                <Button Content="更改文件夹" Style="{StaticResource LinkButton}"
                                                        Click="ChangeCacheFolder_Click" ToolTip="选择一个新的缓存文件夹" />
                                                <Button Content="打开文件夹" Style="{StaticResource LinkButton}"
                                                        Margin="18,0,0,0" Click="OpenCacheFolder_Click"
                                                        ToolTip="在文件资源管理器中打开缓存目录" />
                                                <Button Content="恢复默认" Margin="18,0,0,0" Click="ResetCacheFolder_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCustomCache}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CacheLocationHint}" Style="{StaticResource Hint}" Margin="0,8,0,0" />

                                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,16,0,14" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="当前壁纸、最后成功壁纸和内置保底图不会被删除，即使它们超出上限。" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource ChipBg}"
                                                            BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                    </Border>
                                                    <TextBlock Text="桌面外观" Style="{StaticResource CardTitle}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,20"
                                                           Text="样式对全部显示器生效，跨屏适合拼接成一张完整画面。" />
                                                <TextBlock Text="界面主题" Style="{StaticResource FieldLabel}" />
                                                <ComboBox SelectedIndex="{Binding ThemeIndex}" Margin="0,7,0,18">
                                                    <ComboBoxItem Content="跟随系统" />
                                                    <ComboBoxItem Content="深色" />
                                                    <ComboBoxItem Content="浅色" />
                                                </ComboBox>
                                                <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,2,0,16" />
                                                <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding StartWithWindows}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="运行状态" Style="{StaticResource CardTitle}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12.5"
                                                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hint}"
                                                           Margin="0,8,0,16" />
                                                <Button Content="立即换一张" Style="{StaticResource LinkButton}"
                                                        Click="Next_Click" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Row="1" Grid.ColumnSpan="3" CornerRadius="14" Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="18,15" Margin="0,22,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" MaxWidth="760"
                                                       Text="缓存文件保存在上面指定的目录。退出应用不会删除任何图片，下次启动会直接复用，减少重复下载。" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- ============ 关于 ============ -->
                            <StackPanel x:Name="AboutPage" Opacity="0" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="34,32">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="66" Height="66" CornerRadius="18" Background="{DynamicResource AccentGradient}">
                                            <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                                       Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" />
                                        </Border>
                                        <TextBlock Text="NAS Wallpaper" FontSize="21" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,18,0,0" />
                                        <Border Margin="0,10,0,0" Padding="9,3" CornerRadius="7" Background="{DynamicResource BadgeBg}"
                                                BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                                HorizontalAlignment="Center">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="NoWrap">
                                                <Run Text="版本 " /><Run Text="{Binding Version, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="一个只属于你的 NAS 壁纸工具。图片在本地缓存，桌面在后台切换；没有广告，没有遥测，也没有常驻后台服务。"
                                                   MaxWidth="470" TextAlignment="Center" FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,18,0,0"
                                                   LineHeight="21" />
                                        <UniformGrid Columns="3" Margin="0,26,0,0">
                                            <Border CornerRadius="12" Background="{DynamicResource TileBg}" Padding="14,12" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                               Foreground="{DynamicResource Success}" TextWrapping="NoWrap" />
                                                    <TextBlock Text="无广告" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,2" />
                                                    <TextBlock Text="不含任何推广" Style="{StaticResource Hint}" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="12" Background="{DynamicResource TileBg}" Padding="14,12" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                               Foreground="{DynamicResource Accent}" TextWrapping="NoWrap" />
                                                    <TextBlock Text="无遥测" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,2" />
                                                    <TextBlock Text="不收集使用数据" Style="{StaticResource Hint}" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="12" Background="{DynamicResource TileBg}" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                               Foreground="{DynamicResource Accent}" TextWrapping="NoWrap" />
                                                    <TextBlock Text="本地优先" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,2" />
                                                    <TextBlock Text="断网也能换图" Style="{StaticResource Hint}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}"
                                        BorderThickness="1" Padding="18,15" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0"
                                                   TextWrapping="NoWrap" />
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="SMB 路径示例" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                                                       Text="\\192.168.1.100\Photos — 请先在资源管理器中确认该目录可以正常访问，程序沿用 Windows 登录凭据。" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="软件更新" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="直接从 GitHub Releases 检查并安装新版本。" />

                                        <TextBlock Text="更新源" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                                        <TextBox Text="{Binding UpdateRepository, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="owner/repo（例如 acme/NAS-Wallpaper）" Margin="0,7,0,0"
                                                 Width="380" HorizontalAlignment="Left" />

                                        <CheckBox Content="启动时自动检查更新" IsChecked="{Binding CheckUpdates}" Margin="0,12,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="检查更新" Style="{StaticResource GhostButton}"
                                                    Click="CheckUpdate_Click" />
                                            <Button Content="下载并更新" Height="36" Margin="10,0,0,0"
                                                    Click="InstallUpdate_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Hint}" Margin="0,10,0,0" />

                                        <StackPanel Margin="0,10,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUpdateNotes}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="更新说明" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding UpdateNotes}" Style="{StaticResource Hint}"
                                                       Margin="0,5,0,0" MaxHeight="72" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作栏 -->
                    <Border Grid.Row="2" Margin="36,16,36,18" CornerRadius="14" Background="{DynamicResource FooterBg}"
                            BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="FootDot" Width="6" Height="6" Fill="{DynamicResource Accent}"
                                     VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="10,0,16,0" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <Button Grid.Column="2" Content="保存设置" Click="Save_Click" Height="36"
                                    Style="{StaticResource PrimaryButton}" Padding="20,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 提示气泡 -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,92"
                Padding="16,11" CornerRadius="12" Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource ToastStroke}"
                BorderThickness="1" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastShift" Y="10" /></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastGlyph" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource Success}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <TextBlock x:Name="ToastText" Margin="9,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                           TextWrapping="NoWrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
